####################################################################
# Tavi API — development environment
# Copy this file to `.env` and fill it in. `.env` is not committed.
####################################################################

# ─── Required ─────────────────────────────────────────────────────

# PostgreSQL connection. For the database that `docker compose up -d`
# brings up locally, use the same password as DB_PASSWORD in the root .env.
DATABASE_URL=postgresql://tavi:changeme@localhost:5436/tavi

# Signs session cookies. Generate:  openssl rand -hex 32
# Changing it signs everyone out.
JWT_SECRET=changeme

# ─── Server ───────────────────────────────────────────────────────

# The port the API listens on (the web dev server proxies to it).
API_PORT=3457

# The address of the app in the browser. Google OAuth redirects and
# the links in email are built from it.
WEB_ORIGIN=http://localhost:5173

# In production, the externally visible address. Falls back to WEB_ORIGIN.
# PUBLIC_ORIGIN=https://tavi.example.com

# Send cookies over HTTPS only? Set 1 in production.
COOKIE_SECURE=0

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Where file attachments are written (must be a persistent volume).
UPLOAD_DIR=data/attachments

# ─── Registration and sign-in ─────────────────────────────────────

# Is self-service sign-up with email and password open?
# Set 0 to run invitation-only.
REGISTRATION_ENABLED=1

# Local development only: signs in with one click, without going to Google.
# MUST be 0 in production.
DEV_LOGIN=1

# ─── Google sign-in (optional) ────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials →
# OAuth client ID → Web application
# Authorised redirect URI:  ${WEB_ORIGIN}/auth/google/callback
# Leave empty and the Google button never appears on the login screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email notifications (optional) ───────────────────────────────
# With SMTP_HOST empty, sending is skipped silently; in-app
# notifications keep working.
SMTP_HOST=
SMTP_PORT=587
# Use TLS directly (usually 1 for 465, 0 for 587).
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Tavi <no-reply@example.com>"

# ─── Assistant (optional) ─────────────────────────────────────────
# With a key set, the chat bubble appears; with none the app runs
# exactly as before and the bubble does not exist.
#
# Two providers are supported. Which one is used depends on which key
# is filled in; with both filled in AGENT_PROVIDER decides, and if
# that is empty too, Anthropic wins.

# Anthropic — console.anthropic.com → API keys
AGENT_API_KEY=
# Gemini — aistudio.google.com/apikey
GEMINI_API_KEY=

# anthropic | gemini — only needed when both keys are set
AGENT_PROVIDER=

# Model. AGENT_MODEL applies to both providers; GEMINI_MODEL is read
# only when Gemini is selected and overrides AGENT_MODEL.
# Defaults: claude-opus-5 / gemini-3.1-pro-preview
AGENT_MODEL=
GEMINI_MODEL=

# Thinking depth: low | medium | high (Anthropic only)
AGENT_EFFORT=medium

# Safety limits — the assistant cannot exceed these in one request.
AGENT_MAX_STEPS=8
AGENT_MAX_WRITES=20
AGENT_MAX_BULK=20
AGENT_TIMEOUT_MS=90000
