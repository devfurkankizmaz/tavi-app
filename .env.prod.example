####################################################################
# Tavi — self-host / production
# Copy:  cp .env.prod.example .env.prod
# Run:   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
####################################################################

# ─── Required secrets ─────────────────────────────────────────────
# Generate both:  openssl rand -hex 32
DB_PASSWORD=changeme
JWT_SECRET=changeme

# ─── Address ──────────────────────────────────────────────────────
# The full address the app is reached at in people's browsers.
# Google sign-in, share links and email links are all built from it.
PUBLIC_ORIGIN=https://tavi.example.com

# The port the container publishes on the host. Put a reverse proxy
# that terminates HTTPS (Caddy, Traefik, nginx) in front of it.
HTTP_PORT=8080

# Leave at 1 behind HTTPS. Set 0 only if you are trying it over plain
# HTTP (otherwise the cookie is never sent and sign-in cannot work).
COOKIE_SECURE=1

# ─── Registration ─────────────────────────────────────────────────
# 1: anyone can sign up with email and password
# 0: closed — people sign in with Google only, or arrive by invitation
REGISTRATION_ENABLED=1

# ─── Google sign-in (optional) ────────────────────────────────────
# Authorised redirect URI:  ${PUBLIC_ORIGIN}/auth/google/callback
# For internal use, choosing OAuth "Internal" limits sign-in to
# accounts on your own domain.
# Leave empty and the Google button never appears on the login screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email notifications (optional) ───────────────────────────────
# Leave empty and notifications stay inside the app only.
# Examples:
#   Gmail/Workspace : smtp.gmail.com : 587 : app password
#   Postmark        : smtp.postmarkapp.com : 587
#   Resend          : smtp.resend.com : 465 (SMTP_SECURE=1)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Tavi <no-reply@example.com>"

# ─── Logging ──────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ─── Assistant (optional) ─────────────────────────────────────────
# With a key set, the chat bubble appears; with none the app runs
# exactly as before and the bubble does not exist.
#
# Two providers are supported. Which one is used depends on which key
# is filled in; with both filled in AGENT_PROVIDER decides, and if
# that is empty too, Anthropic wins.

# Anthropic — console.anthropic.com → API keys
AGENT_API_KEY=
# Gemini — aistudio.google.com/apikey
GEMINI_API_KEY=

# anthropic | gemini — only needed when both keys are set
AGENT_PROVIDER=

# Model. AGENT_MODEL applies to both providers; GEMINI_MODEL is read
# only when Gemini is selected and overrides AGENT_MODEL.
# Defaults: claude-opus-5 / gemini-3.1-pro-preview
AGENT_MODEL=
GEMINI_MODEL=

# Thinking depth: low | medium | high (Anthropic only)
AGENT_EFFORT=medium

# Safety limits — the assistant cannot exceed these in one request.
AGENT_MAX_STEPS=8
AGENT_MAX_WRITES=20
AGENT_MAX_BULK=20
AGENT_TIMEOUT_MS=90000
